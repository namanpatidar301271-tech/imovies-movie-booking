{
  "name": "imovies-movie-booking",
  "version": "1.0.0",
  "description": "District-inspired Movie Ticket Booking Platform (MERN)",
  "main": "api/index.js",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "vercel-build": "cd client && npm install && npm run build",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "Naman Patidar (namanpatidar301271-tech)",
  "license": "MIT"
}
